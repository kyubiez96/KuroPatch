<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#070A12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KuroPatch"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#EEF1F8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game localisation, on-device"
            android:textSize="14sp"
            android:textColor="#8B94AD"
            android:layout_marginBottom="24dp" />

        <!-- JAR card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#141926"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E2740"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvJarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#EEF1F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pick .jar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickJar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pick .jar"
            app:cornerRadius="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Extract -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtract"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Extract strings"
            android:enabled="false"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="16dp" />

        <!-- Strings card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStrings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#141926"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E2740"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target language"
                    android:textColor="#8B94AD"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Translation provider"
                    android:textColor="#8B94AD"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Translate -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTranslate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Auto-translate"
            android:enabled="false"
            app:cornerRadius="14dp"
            app:backgroundTint="#5B9DFF"
            android:layout_marginBottom="12dp" />

        <!-- Patch -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Patch .jar"
            android:enabled="false"
            app:cornerRadius="14dp"
            app:backgroundTint="#2EE06F"
            android:layout_marginBottom="16dp" />

        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick a .jar to start"
            android:textColor="#8B94AD"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
