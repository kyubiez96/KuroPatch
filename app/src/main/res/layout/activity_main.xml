<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#070A12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KuroPatch"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#EEF1F8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game localisation, on-device"
            android:textSize="14sp"
            android:textColor="#8B94AD"
            android:layout_marginBottom="24dp" />

        <!-- JAR card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#141926"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E2740"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvJarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#EEF1F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pick .jar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickJar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pick .jar"
            app:cornerRadius="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Extract -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtract"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Extract strings"
            android:enabled="false"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="16dp" />

        <!-- Strings card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStrings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#141926"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E2740"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target language"
                    android:textColor="#8B94AD"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Translation provider"
                    android:textColor="#8B94AD"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cloud mode (kuro.eksi.biz.id). Default OFF: the local
             on-device pipeline stays the default. When ON, the
             Translate button routes to the cloud flow (upload .jar,
             server translates, download result) instead of the local
             Chaquopy pipeline. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cloud mode"
            android:textColor="#EEF1F8"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server translates the .jar (v1: English → Indonesian only). Default OFF."
            android:textColor="#8B94AD"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Cloud LLM key (ai.eksi.biz.id). Only visible in cloud mode.
             This is a SEPARATE key from the Agnes key above: the cloud
             backend forwards it to the ai.eksi.biz.id gateway. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudKey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Set cloud LLM key"
            android:visibility="gone"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="12dp" />

        <!-- Previously translated cloud results (server library). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudLibrary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cloud library"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="12dp" />

        <!-- Translate -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTranslate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Auto-translate"
            android:enabled="false"
            app:cornerRadius="14dp"
            app:backgroundTint="#5B9DFF"
            android:layout_marginBottom="12dp" />

        <!-- Change the saved Agnes API key. Without this, a saved key
             (e.g. pasted with a typo) could never be replaced from
             the app: translate would fail 401 forever until
             clear-data / reinstall. Opens the same prompt as the
             first-time flow. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeKey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Change API key"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="12dp" />

        <!-- Patch -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Patch .jar"
            android:enabled="false"
            app:cornerRadius="14dp"
            app:backgroundTint="#2EE06F"
            android:layout_marginBottom="12dp" />

        <!-- Save patched .jar (system save dialog) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save patched .jar"
            android:enabled="false"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="12dp" />

        <!-- Share patched .jar (FileProvider) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Share"
            android:enabled="false"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="16dp" />

        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick a .jar to start"
            android:textColor="#8B94AD"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
