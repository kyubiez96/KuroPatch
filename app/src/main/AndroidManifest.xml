<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NOTE: no READ_EXTERNAL_STORAGE. The app reads/writes files
      only through the Storage Access Framework (OpenDocument /
      CreateDocument), which needs no storage permission on any API
      level. A declared-but-never-requested permission would only
      mislead users in App info. -->

    <!-- allowBackup=false: the Agnes BYOK key lives in SharedPreferences
      and must not be swept into the user's cloud backup. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.Dark.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- configChanges: rotation must NOT recreate the activity.
              all flow state (jarUri, extracted/translated strings) is
              in-memory, and a recreate mid-translate would orphan the
              background thread AND lose the user's progress. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the patched .jar with other apps. Authorities use the build's
          applicationId so the debug suffix does not break sharing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
